{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm vite build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --prefer-frozen-lockfile --prefer-offline",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/((?!assets/|api/|_vercel/|favicon\\.ico).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/*.ts": {
      "includeFiles": "server/**"
    }
  },
  "env": {
    "ENABLE_FILE_SYSTEM_API": "1"
  }
}
